-- Recipes that have been modified are represented by their modification, which
-- takes their place until it is kept as a copy or overwrites them.
selectSummariesByUserId:
SELECT r.id, r.title, r.spoonacular_id, r.image_url, r.favorite, r.modified_from
FROM recipe r
WHERE r.user_id = ?
  AND NOT EXISTS (SELECT 1 FROM recipe m WHERE m.modified_from = r.id);

selectByUserIdAndId:
SELECT *
FROM recipe
WHERE user_id = ? AND id = ?;

selectStepsByRecipeId:
SELECT instruction
FROM recipe_step
WHERE recipe_id = ?
ORDER BY position;

selectIngredientsByRecipeId:
SELECT name, amount, unit
FROM recipe_ingredient
WHERE recipe_id = ?
ORDER BY position;

selectNutrientsByRecipeId:
SELECT name, amount, unit
FROM recipe_nutrient
WHERE recipe_id = ?
ORDER BY position;

insert:
INSERT INTO recipe (user_id, spoonacular_id, title, image_url, description,
                    preparation_minutes, cooking_minutes, total_minutes,
                    min_servings, max_servings, favorite, modified_from)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
RETURNING id;

insertStep:
INSERT INTO recipe_step (recipe_id, position, instruction)
VALUES (?, ?, ?);

insertIngredient:
INSERT INTO recipe_ingredient (recipe_id, position, name, amount, unit)
VALUES (?, ?, ?, ?, ?);

insertNutrient:
INSERT INTO recipe_nutrient (recipe_id, position, name, amount, unit)
VALUES (?, ?, ?, ?, ?);

updateAllByUserIdAndId:
UPDATE recipe
SET title               = :title,
    image_url           = :imageUrl,
    description         = :description,
    preparation_minutes = :preparationMinutes,
    cooking_minutes     = :cookingMinutes,
    total_minutes       = :totalMinutes,
    min_servings        = :minServings,
    max_servings        = :maxServings,
    favorite            = :favorite,
    modified_from       = :modifiedFrom
WHERE user_id = :userId AND id = :id
RETURNING id;

deleteStepsByRecipeId:
DELETE FROM recipe_step
WHERE recipe_id = ?;

deleteIngredientsByRecipeId:
DELETE FROM recipe_ingredient
WHERE recipe_id = ?;

deleteNutrientsByRecipeId:
DELETE FROM recipe_nutrient
WHERE recipe_id = ?;

deleteByUserIdAndId:
DELETE FROM recipe
WHERE user_id = ? AND id = ?
RETURNING id;
