selectByUserId:
SELECT *
FROM recipe_summary
WHERE user_id = ?;

insert:
INSERT INTO recipe_summary (user_id, title, spoonacular_id, image_url)
VALUES (?, ?, ?, ?)
RETURNING id, title, spoonacular_id, image_url;

deleteByUserIdAndId:
DELETE FROM recipe_summary
WHERE user_id = ? AND id = ?
RETURNING id;
